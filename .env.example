# ============================================================================
# GateVision — environment template
#
#   cp .env.example .env && docker compose up --build -d
#
# Defaults are production oriented: CV_MODE=real, no demo data, demo feeds off.
#
# Every value below is read by the backend through pydantic-settings.
# ============================================================================

# ------------------------------------------------------------------ runtime
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=text
DEFAULT_TIMEZONE=Africa/Cairo

# ----------------------------------------------------------------- security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5

# ----------------------------------------------------------------- database
# Inside docker compose the hostnames are the service names.
POSTGRES_USER=gatevision
POSTGRES_PASSWORD=gatevision
POSTGRES_DB=gatevision
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gatevision:gatevision@postgres:5432/gatevision
# Local SQLite fallback (no Docker):
# DATABASE_URL=sqlite+aiosqlite:///./gatevision.db
AUTO_CREATE_TABLES=false
DATABASE_ECHO=false

# -------------------------------------------------------------------- redis
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
REDIS_EVENT_CHANNEL=gatevision:events
CACHE_TTL_SECONDS=30

# ---------------------------------------------------------------------- web
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","http://127.0.0.1:5173"]
TRUSTED_HOSTS=["*"]
API_V1_PREFIX=/api/v1
MEDIA_ROOT=/data/media
MEDIA_URL=/media
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------- bootstrap
# true  -> create the demo compound (Palm Hills), residents, permits and history.
# false -> only the bootstrap admin account (recommended for a real site).
SEED_DEMO_DATA=false
SEED_ADMIN_EMAIL=admin@gatevision.app
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=GateVision Administrator

# ------------------------------------------------------------------- vision
CV_ENABLED=true
# The API process never runs camera workers when the compose cv-worker service exists.
CV_RUNNER_ENABLED=false
# real = YOLO plate detector + OCR + InsightFace (production default)
# mock = deterministic simulated detections, development/demo only
CV_MODE=real
CV_PLATE_DETECTOR=yolo
CV_PLATE_MODEL_PATH=/app/models/plate_yolov8.pt
CV_YOLO_IMAGE_SIZE=640
CV_YOLO_IOU=0.45
CV_YOLO_DEVICE=
CV_YOLO_HALF=false
CV_OCR_ENGINE=easyocr
# Add "ar" when the cameras see purely Arabic plates (slower, more RAM).
CV_OCR_LANGUAGES=["en"]
CV_OCR_ALLOWLIST=true
CV_FACE_ENGINE=insightface
CV_FACE_MODEL_NAME=buffalo_l
CV_FACE_SIMILARITY_THRESHOLD=0.45
CV_PLATE_CONFIDENCE_THRESHOLD=0.35
CV_OCR_MIN_CONFIDENCE=0.45
CV_MIN_PLATE_ASPECT=1.6
CV_MAX_PLATE_ASPECT=7.0
CV_MAX_FPS=5
CV_DEDUPE_SECONDS=8
CV_FRAME_WIDTH=1280
CV_SNAPSHOT_QUALITY=85
# Synthetic demo feeds are refused in real mode unless explicitly allowed.
CV_DEMO_CAMERAS=false
CV_DEMO_INTERVAL_SECONDS=9
CV_ALLOW_DEMO_SOURCES=false

# ------------------------------------------------------- camera transport
# tcp is mandatory for reliable plates on most IP cameras / NVRs.
CV_RTSP_TRANSPORT=tcp
CV_RTSP_OPEN_TIMEOUT_MS=5000
CV_RTSP_READ_TIMEOUT_MS=5000
CV_RECONNECT_DELAY_SECONDS=2
CV_RECONNECT_MAX_DELAY_SECONDS=30
CV_STALL_TIMEOUT_SECONDS=20
CV_CAMERA_PROBE_FRAMES=5

# ------------------------------------------------------------- night vision
CV_LOW_LIGHT_ENHANCE=true
CV_LOW_LIGHT_THRESHOLD=70
CV_LOW_LIGHT_CLIP_LIMIT=2.5

# ---------------------------------------------------- cameras from the env
# JSON list applied on every boot (idempotent). Credentials can reference env
# vars with ${VAR} so passwords never live inside the database.
# CAMERAS_JSON=[{"gate_code":"GATE-IN","name":"Entry lane","url":"rtsp://admin:${CAM_IN_PASS}@10.0.0.11:554/Streaming/Channels/101"},{"gate_code":"GATE-OUT","name":"Exit lane","url":"rtsp://admin:${CAM_OUT_PASS}@10.0.0.12:554/Streaming/Channels/101"}]

# ------------------------------------------------------------------- barrier
# simulator | webhook | mqtt | gpio   (per-compound policy overrides this)
BARRIER_DRIVER=simulator
BARRIER_WEBHOOK_URL=
BARRIER_WEBHOOK_SECRET=
BARRIER_WEBHOOK_TIMEOUT_SECONDS=3
BARRIER_COMMAND_TIMEOUT_SECONDS=10

# -------------------------------------------------------------------- limits
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200
EXPORT_ROW_LIMIT=50000
RETENTION_DAYS=365

# -------------------------------------------------------------- schedulers
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=900

# -------------------------------------------------------------------- models
# Host directory mounted read-only into the cv-worker at /app/models.
CV_MODELS_DIR=./backend/models

# ---------------------------------------------------------------- frontend
# Consumed at build time by the Vite image.
VITE_API_BASE_URL=/api/v1
VITE_MEDIA_BASE_URL=
