# GateVision backend — local (non-Docker) configuration.
# Copy to backend/.env or export the variables in your shell.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text
DEFAULT_TIMEZONE=Africa/Cairo
SECRET_KEY=local-dev-secret-change-me-please

# Local SQLite keeps the stack dependency-free; switch to PostgreSQL for parity.
DATABASE_URL=sqlite+aiosqlite:///./gatevision.db
# DATABASE_URL=postgresql+asyncpg://gatevision:gatevision@localhost:5432/gatevision
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MEDIA_ROOT=./media

CV_ENABLED=true
CV_RUNNER_ENABLED=true
CV_MODE=mock
CV_DEMO_INTERVAL_SECONDS=9

MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=900
