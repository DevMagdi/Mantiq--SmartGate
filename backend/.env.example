# GateVision backend — local (non-Docker) configuration.
# Copy to backend/.env or export the variables in your shell.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text
DEFAULT_TIMEZONE=Africa/Cairo
SECRET_KEY=local-dev-secret-change-me-please

# Local SQLite keeps the stack dependency-free; switch to PostgreSQL for parity.
DATABASE_URL=sqlite+aiosqlite:///./gatevision.db
# DATABASE_URL=postgresql+asyncpg://gatevision:gatevision@localhost:5432/gatevision
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MEDIA_ROOT=./media

# Local development defaults to mock (no model weights needed on a laptop).
# For a real site copy ../.env.example instead: CV_MODE=real + SEED_DEMO_DATA=false.
CV_ENABLED=true
CV_RUNNER_ENABLED=true
CV_MODE=mock
CV_DEMO_INTERVAL_SECONDS=9
CV_ALLOW_DEMO_SOURCES=false

# Real ANPR stacks (CV_MODE=real). Ignored in mock mode.
# Fetch a real Egyptian plate detector:  python3 ../scripts/fetch_plate_model.py
CV_PLATE_MODEL_PATH=models/plate_yolov8.pt
# yolo = Ultralytics .pt | onnx = exported YOLOv5/YOLOv7 (CV_PLATE_DETECTOR=onnx)
CV_PLATE_DETECTOR=yolo
CV_YOLO_IMAGE_SIZE=640
CV_YOLO_IOU=0.45
CV_YOLO_DEVICE=          # "" = auto (CUDA when available), "cpu", "0", "cuda:1"
CV_YOLO_HALF=false
CV_OCR_ENGINE=easyocr
CV_OCR_LANGUAGES=["en"]
CV_OCR_ALLOWLIST=true
CV_PLATE_CLASS_NAMES=plate,license_plate,number_plate,plate_number,car_plate,egy_plate,egyptian_plate,لوحة_سيارة,لوحة
CV_FACE_ENGINE=insightface
CV_FACE_MODEL_NAME=buffalo_l
CV_FACE_SIMILARITY_THRESHOLD=0.45
CV_PLATE_CONFIDENCE_THRESHOLD=0.35
CV_OCR_MIN_CONFIDENCE=0.45

# Camera transport (tcp is required for reliable ANPR on IP cameras/NVRs).
CV_RTSP_TRANSPORT=tcp
CV_RTSP_OPEN_TIMEOUT_MS=5000
CV_RTSP_READ_TIMEOUT_MS=5000
CV_RECONNECT_DELAY_SECONDS=2
CV_RECONNECT_MAX_DELAY_SECONDS=30
CV_STALL_TIMEOUT_SECONDS=20
CV_CAMERA_PROBE_FRAMES=5
CV_LOW_LIGHT_ENHANCE=true
CV_LOW_LIGHT_THRESHOLD=70
CV_FRAME_WIDTH=1280
CV_MAX_FPS=5

# Barrier actuator defaults. Per-compound overrides live in
# PATCH /api/v1/compounds/{id}/settings -> barrier.{driver,webhook,mqtt,gpio}
BARRIER_DRIVER=simulator
BARRIER_WEBHOOK_URL=
BARRIER_WEBHOOK_SECRET=

MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=900
