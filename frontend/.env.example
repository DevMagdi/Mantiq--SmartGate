# URL of the GateVision API as seen by the browser.
# Keep the relative /api/v1 default when using the Vite proxy or the bundled nginx.
VITE_API_BASE_URL=/api/v1

# Optional absolute media origin (e.g. https://gateway.example.com/media).
# Leave empty to load snapshots from the same origin as the API.
VITE_MEDIA_BASE_URL=

# Optional absolute WebSocket endpoint. Defaults to ws(s)://<current host>/api/v1.
# VITE_WS_BASE_URL=wss://gate.example.com/api/v1

# Dev/preview proxy target (never shipped to the browser).
VITE_PROXY_TARGET=http://127.0.0.1:8000
